# TRUSTLENS GLOBAL - Environment Variables Configuration

ENVIRONMENT=production
ENABLE_LIVE_WEBSITE_FETCH=true

# Database Connection (Default: SQLite local persistence)
DATABASE_URL=sqlite+aiosqlite:///./trustlens.db

# Optional Commercial Threat Intelligence API Keys
# (The platform functions out-of-the-box with live open feeds: URLhaus, RDAP, DoH, crt.sh)
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=
